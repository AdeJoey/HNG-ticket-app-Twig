<header class="site-header">
    <div class="container">
        <h1 class="logo">TicketSys</h1>

        <nav class="site-nav">
            <a href="/">Home</a>
            <a href="{% if isAuthenticated %}?route=login{% else %}?route=login{% endif %}">Dashboard</a>
            {% if isAuthenticated %}
                <form method="POST" action="/" style="display: inline;">
                    <input type="hidden" name="action" value="logout">
                    <button type="submit" class="logout-btn">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                            <polyline points="16 17 21 12 16 7"></polyline>
                            <line x1="21" y1="12" x2="9" y2="12"></line>
                        </svg>
                        Logout
                    </button>
                </form>
            {% else %}
                <a href="?route=login">Login</a>
            {% endif %}
        </nav>

        <button class="menu-toggle" id="menuToggle" aria-label="Toggle menu">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="3" y1="12" x2="21" y2="12"></line>
                <line x1="3" y1="6" x2="21" y2="6"></line>
                <line x1="3" y1="18" x2="21" y2="18"></line>
            </svg>
        </button>
    </div>

    <nav class="mobile-nav" id="mobileNav" style="display: none;">
        <a href="/">Home</a>
        <a href="{% if isAuthenticated %}?route=dashboard{% else %}?route=login{% endif %}">Dashboard</a>
        {% if isAuthenticated %}
            <form method="POST" action="/">
                <input type="hidden" name="action" value="logout">
                <button type="submit" class="logout-btn">Logout</button>
            </form>
        {% else %}
            <a href="?route=login">Login</a>
        {% endif %}
    </nav>
</header>

<script>
document.getElementById('menuToggle')?.addEventListener('click', function() {
    const mobileNav = document.getElementById('mobileNav');
    if (mobileNav.style.display === 'none') {
        mobileNav.style.display = 'flex';
    } else {
        mobileNav.style.display = 'none';
    }
});
</script>